{
  "expo": {
    "name": "VitalLink Donor",
    "slug": "vitallink-donor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C62828"
    },
    "android": {
      "package": "com.vitallink.donor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C62828"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#C62828",
          "androidMode": "default",
          "androidCollapsedTitle": "VitalLink Emergency Alert"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VitalLink needs your location to match you with nearby patients."
        }
      ],
      "expo-web-browser"
    ],
    "newArchEnabled": true,
    "extra": {
      "apiUrl": "http://192.168.0.188:8000",
      "googleClientId": {
        "web": "YOUR_WEB_CLIENT_ID.apps.googleusercontent.com",
        "ios": "YOUR_IOS_CLIENT_ID.apps.googleusercontent.com",
        "android": "YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "563ea39a-1ec2-4ad7-b492-e4d783f1310a"
      }
    },
    "owner": "harshsharmax"
  }
}
