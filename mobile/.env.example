# VitalLink Mobile — Environment Variables
# Copy this to .env.local and fill in your values.

# Backend API URL (required for the app to connect)
# For local testing: http://YOUR_MACHINE_IP:8000 (e.g., http://192.168.0.188:8000)
# For production: https://vitallink-backend.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# Firebase (for real OTP login) — optional for dev
# Get these from: Firebase Console → Project Settings → General → Your apps → Web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
