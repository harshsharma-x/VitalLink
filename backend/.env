# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — works with no extra setup)
DATABASE_URL=sqlite:///./vitallink.db

# PostgreSQL (uncomment and set credentials when running PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitallink

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=vitallink-jwt-secret-change-in-production-2026

# ── Google Places API ───────────────────────────────────────────────────────
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=
