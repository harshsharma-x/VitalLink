# ── Google Places API ───────────────────────────────────────────────────────
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable: "Places API" in the Google Cloud Console
# Free tier: $200/month credit ≈ 10,000 Nearby Search calls
GOOGLE_PLACES_API_KEY=

# ── Database (optional — not required for hospitals/blood banks) ─────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitallink
