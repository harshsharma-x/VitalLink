# Database
DATABASE_URL=sqlite:///./vitallink.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitallink

# JWT
JWT_SECRET_KEY=vitallink-dev-secret-key-change-in-production

# CORS - comma-separated origins, use * for development
CORS_ORIGINS=*
# Production: CORS_ORIGINS=https://vitallink-app.vercel.app

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Fast2SMS (optional)
# FAST2SMS_API_KEY=your-fast2sms-api-key

# Firebase (optional)
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0
