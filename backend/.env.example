[TEMPLATE]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitallink
JWT_SECRET_KEY=your-secret-key-here-change-in-production
REDIS_URL=redis://localhost:6379/0

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Web Client ID from Google Cloud Console → APIs & Services → Credentials
# Used to verify the audience claim of Google ID tokens (security best practice)
# Set this to the same Web Client ID you configure in the mobile apps' app.json.
# If not set, audience verification is skipped (less secure, but works for testing)
GOOGLE_CLIENT_ID=
